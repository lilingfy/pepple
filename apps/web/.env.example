# Pebble Environment Configuration
# 复制此文件为 .env.local 并填入你的API Key

# ==========================================
# LLM Provider Configuration
# 默认使用智谱AI (Zhipu)
# ==========================================

# 智谱AI API Key (必填，用于AI分析功能)
# 获取地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here

# 默认LLM提供商 (可选，默认为 zhipu)
# 可选值: zhipu, openai, anthropic
DEFAULT_LLM_PROVIDER=zhipu

# OpenAI API Key (可选，如果你希望使用OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (可选，如果你希望使用Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# Database Configuration (Optional)
# 用于用户认证和数据持久化
# ==========================================

# PostgreSQL Database URL
# DATABASE_URL=postgresql://user:password@localhost:5432/pebble

# Clerk Authentication (Optional)
# 用于用户认证
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# CLERK_SECRET_KEY=your_clerk_secret_key

# ==========================================
# Application Configuration
# ==========================================

# 应用基础URL
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Pebble Environment Configuration
# 复制此文件为 .env.local 并填入你的API Key

# ==========================================
# Supabase Authentication (Required)
# 用于用户认证和会话管理
# ==========================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (public, safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# LLM Provider Configuration
# 默认使用 NVIDIA OpenAI-compatible endpoint，可按需切换 provider
# ==========================================

# NVIDIA API Catalog（当前推荐，OpenAI-compatible）
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct

# 默认LLM提供商 (可选，默认为 nvidia)
# 可选值: nvidia, zhipu, openai, anthropic
DEFAULT_LLM_PROVIDER=nvidia

# 智谱AI API Key (可选，如果你希望使用智谱官方接口)
# 获取地址: https://open.bigmodel.cn/
# ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenAI API Key (可选，如果你希望使用OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (可选，如果你希望使用Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# Database Configuration (Optional)
# 用于用户认证和数据持久化
# ==========================================

# PostgreSQL Database URL
# DATABASE_URL=postgresql://user:password@localhost:5432/pebble

# ==========================================
# Application Configuration
# ==========================================

# 应用基础URL
NEXT_PUBLIC_APP_URL=http://localhost:3020
